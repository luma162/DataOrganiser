<Window x:Class="DataOrganiser.Views.Settings.ManageExtensionGroups"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataOrganiser.Views.Settings"
        mc:Ignorable="d"
        Title="ManageExtensionGroups" Height="750" Width="600"
        Background="#191f2e">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ManageGroupTitle}" Foreground="White" FontSize="24" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Group Name" Foreground="White" FontSize="16" Margin="0,0,0,5"/>

            <TextBox Text="{Binding EditingGroup.Name, UpdateSourceTrigger=PropertyChanged}"
                     Height="30"
                     Background="#232a3a"
                     Foreground="White"
                     BorderBrush="#3B3B50"
                     Style="{StaticResource RoundedTextBoxWithPlaceholder}"
                     Tag="Enter group name"/>


            <TextBlock Text="Add Extensions" Foreground="White" FontSize="16" Margin="0,20,0,5"/>

            <StackPanel Orientation="Horizontal">
                <TextBox Width="300"
                         Height="30"
                         Text="{Binding ExtensionInput, UpdateSourceTrigger=PropertyChanged}"
                         Background="#232a3a"
                         Foreground="White"
                         BorderBrush="#3B3B50"
                         Style="{StaticResource RoundedTextBoxWithPlaceholder}"
                         Tag="Example: .png"/>

                <Button Content="Add"
                        Command="{Binding AddExtensionCommand}"
                        Style="{StaticResource RoundedButtonStyle}"
                        Width="70"
                        Height="30"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,10,0,10" Background="#232a3a" CornerRadius="8">
            <ListBox ItemsSource="{Binding EditingGroup.Extensions}"
             Background="Transparent"
             BorderThickness="0"
             Margin="0,10,0,10">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button Content="Delete"
                                    Width="40"
                                    Margin="0,0,5,0"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    BorderBrush="#B22222"
                                    Foreground="White"
                                    Background="#C70039"
                                    Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    CommandParameter="{Binding}"/>

                            <TextBlock Text="{Binding}"
                               Foreground="White"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Grid.Row="3"
                Content="{Binding ManageGroupButtonText}"
                Command="{Binding SaveGroupCommand}"
                Style="{StaticResource RoundedButtonStyle}"
                Height="35"/>
    </Grid>
</Window>
