<UserControl x:Class="DataOrganiser.ExtensionGroups"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataOrganiser"
             xmlns:models="clr-namespace:DataOrganiser.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Extension Groups" Foreground="White" FontSize="24" Grid.Row="0"/>

        <TextBlock Text="Press the refresh button on the main window after making any changes." Foreground="White" Grid.Row="1" Margin="0,5,0,0"/>

        <Button Command="{Binding AddGroupClickCommand}" Content="Add Group" Margin="0,15,0,0" Grid.Row="2" Padding="10,0" Height="25" HorizontalAlignment="Left" Style="{StaticResource RoundedButtonStyle}" BorderBrush="White" Foreground="White" Background="#232a3a"></Button>

        <ListBox Grid.Row="3" ItemsSource="{Binding ExtensionGroups}" Margin="0,10,0,0" Background="#191f2e">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ExtensionGroupModel}">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Button Command="{Binding DataContext.DeleteGroupClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" Content="Delete" Margin="0,0,5,0" Width="40" Style="{StaticResource RoundedButtonStyle}" BorderBrush="#B22222" Foreground="White" Background="#C70039"></Button>
                        <Button Command="{Binding DataContext.EditGroupClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}" Content="Edit" Margin="0,0,5,0" Width="30" Style="{StaticResource RoundedButtonStyle}" Background="#232a3a" BorderBrush="White" Foreground="White"></Button>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExtensionsDisplay}" Foreground="White" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
