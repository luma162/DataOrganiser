<UserControl x:Class="DataOrganiser.ExcludedFolderSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataOrganiser" xmlns:models="clr-namespace:DataOrganiser.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel Margin="20">
        <TextBlock Text="Excluded Folders" Foreground="White" FontSize="24"/>
        <TextBlock Text="Add folders to exclude from the data indexing process. These folders will not be scanned or modified." Foreground="White" Margin="0,15,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
            
            <TextBox x:Name="ExcludedFoldersTextBox" TextChanged="ExcludedFoldersTextBox_TextBoxChanged"  Width="200" IsReadOnly="False" Style="{StaticResource RoundedTextBoxWithPlaceholder}" Background="#232a3a" BorderBrush="#232a3a" Tag="Folder Name / Path:" Foreground="White"/>
            <Button x:Name="ExcludedFoldersAdd" Content="Add" Foreground="White" Background="#232a3a" BorderBrush="#232a3a" Width="50" Height="25" Margin="5,0,0,0" VerticalAlignment="Center" Click="AddExcludedFolder_Click" Style="{StaticResource RoundedButtonStyle}"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding ExcludedFolders}" Background="#191f2e" Foreground="White" Width="450" Height="500" HorizontalAlignment="Left" Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2">
                        <Button Content="✖" Width="18" Click="RemoveFolder_Click" Tag="{Binding}" Margin="0,0" Background="#232a3a" Foreground="Red" FontSize="8" Style="{StaticResource RoundedButtonStyle}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="5,0"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
