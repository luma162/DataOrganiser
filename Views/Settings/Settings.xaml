<Window x:Class="DataOrganiser.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataOrganiser"
        mc:Ignorable="d"
        Title="Settings" 
        Height="800"
        Width="900"
        MinWidth="900"
        MinHeight="600"
        Background="#191f2e">

    <Window.Resources>
        <Style x:Key="SidebarBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#0d1121">
            <Button Style="{StaticResource SidebarButtonStyle}" Command="{Binding SideBarContentClickCommand}" CommandParameter="General">
                <StackPanel Orientation="Horizontal">
                    <Button Content=""
                            Height="35"
                            Width="35"
                            IsHitTestVisible="False"
                            Style="{StaticResource RoundedButtonStyle}"
                    />

                    <TextBlock Text="General"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"
                               FontSize="14"
                    />
                </StackPanel>
            </Button>


            <Button Style="{StaticResource SidebarButtonStyle}"
                    Command="{Binding SideBarContentClickCommand}"
                    CommandParameter="ExcludedFolders">
                <StackPanel Orientation="Horizontal">
                    <Button Content=""
                            Height="35"
                            Width="35"
                            IsHitTestVisible="False"
                            Style="{StaticResource RoundedButtonStyle}"
                    />

                    <TextBlock Text="Excluded Folders"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"
                               FontSize="14"
                    />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SidebarButtonStyle}"
                    Command="{Binding SideBarContentClickCommand}"
                    CommandParameter="ExtensionGroups">

                <StackPanel Orientation="Horizontal">
                    <Button Content=""
                            Height="35"
                            Width="35"
                            IsHitTestVisible="False"
                            Style="{StaticResource RoundedButtonStyle}"
                    />

                    <TextBlock Text="Extension Groups"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"
                               FontSize="14"
                    />
                </StackPanel>
            </Button>
        </StackPanel>
        
        <ContentControl x:Name="ContentArea" Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
