<UserControl x:Class="DataOrganiser.GeneralSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataOrganiser"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="20">
        <TextBlock Text="General Settings" Foreground="White" FontSize="24"/>
        <TextBlock Text="Recent Dump Duration" Foreground="White" Margin="0,10,0,0"/>
        <ComboBox x:Name="RecentDumpDuration" IsEditable="False" IsReadOnly="False" Width="200px" Margin="0,-15,100,0">
            <ComboBoxItem Content="1 hour"/>
            <ComboBoxItem Content="5 hours"/>
            <ComboBoxItem Content="12 hours"/>
            <ComboBoxItem Content="1 day"/>
            <ComboBoxItem Content="2 days"/>
            <ComboBoxItem Content="5 days"/>
            <ComboBoxItem Content="7 days"/>
            <ComboBoxItem Content="14 days"/>
        </ComboBox>
    </StackPanel>
</UserControl>
